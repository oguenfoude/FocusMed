<?xml version="1.0" encoding="utf-8"?>
<!-- DEPRECATED: This manifest is disabled in the csproj (ApplicationManifest is commented out).
     It requests requireAdministrator UAC elevation for binding TCP port 11112.
     Re-enable by uncommenting <ApplicationManifest>app.manifest</ApplicationManifest> in the csproj. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="FocusMed.Worker.app"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>

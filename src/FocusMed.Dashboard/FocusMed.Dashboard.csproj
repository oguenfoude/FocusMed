<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\FocusMed.Data\FocusMed.Data.csproj" />
    <ProjectReference Include="..\FocusMed.Dicom\FocusMed.Dicom.csproj" />
    <ProjectReference Include="..\FocusMed.Printing\FocusMed.Printing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="fo-dicom.Codecs" Version="5.9.0" />
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
    <PackageReference Include="QuestPDF" Version="2026.7.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <!-- Framework-dependent publish drops hostfxr.dll/hostpolicy.dll next to the apphost;
       the generated exe prefers those app-local hosts and then fails global runtime
       lookup ("No frameworks were found"). Delete them so the apphost resolves the
       machine-wide .NET 10 install. Skipped for self-contained publish, where the
       app-local hosts + bundled runtime are REQUIRED. -->
  <Target Name="RemoveAppLocalHostFx" AfterTargets="Publish" Condition="'$(SelfContained)' != 'true'">
    <Delete Files="$(PublishDir)hostfxr.dll" />
    <Delete Files="$(PublishDir)hostpolicy.dll" />
  </Target>

</Project>

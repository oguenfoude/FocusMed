@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject IConfiguration Config
@inject ILogger<MainLayout> Logger

<div class="flex flex-col min-h-screen bg-slate-50">
    <!-- Top Navbar -->
    <header class="h-16 border-b border-slate-200 bg-white shadow-sm flex items-center px-6 shrink-0 z-10">
        <!-- Brand -->
        <div class="flex items-center gap-3 w-64 shrink-0">
            <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center shadow-md shadow-brand-500/20">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
            </div>
            <div>
                <h1 class="text-lg font-bold text-slate-900 tracking-tight leading-tight">FocusMed</h1>
            </div>
        </div>

        <!-- Main Navigation -->
        <nav class="flex-1 flex items-center gap-1">
            <NavLink href="/" Match="NavLinkMatch.All"
                     ActiveClass="bg-brand-50 text-brand-700 border border-brand-100 hover:bg-brand-100"
                     class="flex items-center gap-2 px-4 py-2 rounded-lg border border-transparent transition-all duration-200 hover:bg-slate-100 hover:border-slate-200 font-medium text-sm text-slate-600">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
                Études
            </NavLink>
            <NavLink href="/archives"
                     ActiveClass="bg-brand-50 text-brand-700 border border-brand-100 hover:bg-brand-100"
                     class="flex items-center gap-2 px-4 py-2 rounded-lg border border-transparent transition-all duration-200 hover:bg-slate-100 hover:border-slate-200 font-medium text-sm text-slate-600">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
                </svg>
                Archives
            </NavLink>
            <NavLink href="/deleted"
                     ActiveClass="bg-brand-50 text-brand-700 border border-brand-100 hover:bg-brand-100"
                     class="flex items-center gap-2 px-4 py-2 rounded-lg border border-transparent transition-all duration-200 hover:bg-slate-100 hover:border-slate-200 font-medium text-sm text-slate-600">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
                Supprimées
            </NavLink>
            <NavLink href="/settings"
                     ActiveClass="bg-brand-50 text-brand-700 border border-brand-100 hover:bg-brand-100"
                     class="flex items-center gap-2 px-4 py-2 rounded-lg border border-transparent transition-all duration-200 hover:bg-slate-100 hover:border-slate-200 font-medium text-sm text-slate-600">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                Paramètres
            </NavLink>
        </nav>


        <!-- Right Side -->
        <div class="flex items-center gap-4 shrink-0">
            <button @onclick="RefreshPage" title="Rafraîchir"
                    class="p-2 rounded-lg text-slate-500 hover:text-slate-700 hover:bg-slate-100 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
            </button>
            <div @onclick="CheckServerNow" role="status" title="État du récepteur DICOM (Worker) — cliquer pour revérifier"
                 class="flex items-center gap-2 text-xs font-semibold px-3 py-1.5 rounded-full border cursor-pointer transition-colors @(ServerOnline
                     ? "text-emerald-700 bg-emerald-50 border-emerald-200"
                     : "text-red-700 bg-red-50 border-red-200")">
                <div class="w-2 h-2 rounded-full @(ServerOnline ? "bg-emerald-500 animate-pulse" : "bg-red-500")"></div>
                @(ServerOnline ? "Serveur actif" : "Serveur hors ligne")
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 overflow-auto flex flex-col min-w-0">
        <div class="p-8 max-w-[1600px] w-full mx-auto">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui" class="hidden fixed bottom-4 left-1/2 -translate-x-1/2 bg-red-100 text-red-900 border border-red-200 px-6 py-3 rounded-xl shadow-lg text-sm z-50" data-nosnippet>
    Une erreur inattendue s'est produite.
    <a href="." class="underline hover:text-red-700 ml-2 font-medium">Recharger</a>
</div>

@code {
    private bool ServerOnline;
    private System.Threading.Timer? _healthTimer;
    private int _dicomPort = 11112;

    protected override void OnInitialized()
    {
        var port = Config.GetValue<int?>("DicomHealth:Port");
        if (port is > 0 and <= 65535) _dicomPort = port.Value;

        ServerOnline = CheckServer();
        // Real liveness probe: TCP connect to the Worker's DICOM listener.
        // The old badge was hardcoded green even when the Worker was down.
        _healthTimer = new System.Threading.Timer(
            _ => { var online = CheckServer(); if (online != ServerOnline) _ = InvokeAsync(() => { ServerOnline = online; StateHasChanged(); }); },
            null, TimeSpan.FromSeconds(15), TimeSpan.FromSeconds(15));
    }

    private void CheckServerNow()
    {
        ServerOnline = CheckServer();
        StateHasChanged();
    }

    private bool CheckServer()
    {
        try
        {
            using var client = new System.Net.Sockets.TcpClient();
            var task = client.ConnectAsync(System.Net.IPAddress.Loopback, _dicomPort);
            return task.Wait(1500) && client.Connected;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "DICOM health probe failed on port {Port}", _dicomPort);
            return false;
        }
    }

    private void RefreshPage()
    {
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    public void Dispose()
    {
        _healthTimer?.Dispose();
    }
}

@page "/settings"
@rendermode InteractiveServer
@inject FocusMed.Printing.Discovery.IPrinterDiscoveryService DiscoveryService
@inject FocusMed.Printing.Discovery.IPrinterCapabilityService CapabilityService
@inject FocusMed.Printing.Profiles.IPrintProfileBuilder ProfileBuilder
@inject FocusMed.Printing.Verification.ITestPageService TestPageService
@inject FocusMed.Printing.Discovery.ICapabilityConfirmationStore ConfirmationStore
@inject FocusMed.Printing.Profiles.IPrinterSettingsStore SettingsStore
@inject Microsoft.Extensions.Options.IOptions<FocusMed.Printing.Jobs.RawPrinterConfig> RawPrinterOptions
@inject ILogger<Settings> Logger

<PageTitle>Paramètres — FocusMed</PageTitle>

<div class="space-y-6">
    @* ── Header ── *@
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Paramètres</h1>
            <p class="text-sm text-slate-500 mt-1">Configuration de l'impression et des imprimantes</p>
        </div>
        <button @onclick="RefreshAll"
                class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            Rafraîchir
        </button>
    </div>

    @* ══════════════════════════════════════════════════════════════════ *@
    @* SECTION 1 : Default Printer & Profile                            *@
    @* ══════════════════════════════════════════════════════════════════ *@
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm">
        <div class="px-6 py-4 border-b border-slate-100">
            <h2 class="text-base font-bold text-slate-900">Imprimante par défaut</h2>
            <p class="text-xs text-slate-500 mt-0.5">Imprimante et profil utilisés par défaut lors de l'impression</p>
        </div>
        <div class="px-6 py-5">
            @if (InstalledPrinters.Count == 0)
            {
                <p class="text-sm text-slate-400">Aucune imprimante détectée.</p>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    @* Printer *@
                    <div>
                        <label class="text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5 block">Imprimante</label>
                        <select @bind="SelectedDefaultPrinter" @bind:after="OnDefaultPrinterChanged"
                                class="w-full text-sm border border-slate-200 rounded-lg px-3 py-2 bg-white text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
                            <option value="">— Aucune —</option>
                            @foreach (var p in InstalledPrinters)
                            {
                                <option value="@p.Name">@p.Name</option>
                            }
                        </select>
                    </div>
                    @* Profile *@
                    <div>
                        <label class="text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5 block">Profil par défaut</label>
                        <select @bind="SelectedDefaultProfile"
                                class="w-full text-sm border border-slate-200 rounded-lg px-3 py-2 bg-white text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500"
                                disabled="@(DefaultProfiles.Count == 0)">
                            <option value="">— Aucun —</option>
                            @foreach (var prof in DefaultProfiles)
                            {
                                <option value="@prof.Name">@prof.Name — @prof.Description</option>
                            }
                        </select>
                    </div>
                    @* Copies *@
                    <div>
                        <label class="text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5 block">Copies par défaut</label>
                        <input type="number" min="1" max="99" @bind="SelectedDefaultCopies"
                               class="w-24 text-sm border border-slate-200 rounded-lg px-3 py-2 bg-white text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
                    </div>
                </div>
                <div class="mt-4 flex items-center gap-3">
                    <button @onclick="SaveDefaultSettings"
                            class="inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold text-white bg-brand-600 hover:bg-brand-700 border border-brand-700 rounded-lg transition-colors shadow-sm">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                        Enregistrer
                    </button>
                    @if (!string.IsNullOrEmpty(SettingsStatus))
                    {
                        <span class="text-xs @(SettingsSaved ? "text-emerald-600" : "text-red-600") font-medium">@SettingsStatus</span>
                    }
                </div>
            }
        </div>
    </div>

    @* ══════════════════════════════════════════════════════════════════ *@
    @* SECTION 2 : Printer List + Capabilities + Test                   *@
    @* ══════════════════════════════════════════════════════════════════ *@
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm">
        <div class="px-6 py-4 border-b border-slate-100">
            <h2 class="text-base font-bold text-slate-900">Imprimantes installées</h2>
            <p class="text-xs text-slate-500 mt-0.5">Découvertes, capacités et tests pour chaque imprimante</p>
        </div>
        <div class="px-6 py-5 space-y-4">
            @if (InstalledPrinters.Count == 0)
            {
                <p class="text-sm text-slate-400">Aucune imprimante détectée.</p>
            }
            @foreach (var printer in InstalledPrinters)
            {
                var snap = Snapshots.GetValueOrDefault(printer.Name);
                var caps = Confirmations.GetValueOrDefault(printer.Name, new());
                var isExpanded = ExpandedPrinter == printer.Name;
                var isTesting = TestingPrinter == printer.Name;

                <div class="border border-slate-200 rounded-xl overflow-hidden">
                    @* Printer header *@
                    <div class="px-4 py-3 flex items-center justify-between bg-slate-50/50">
                        <div class="flex items-center gap-3 min-w-0">
                            <button @onclick="() => ToggleExpand(printer.Name)"
                                    class="p-1 text-slate-400 hover:text-slate-600 transition-colors shrink-0">
                                <svg class="w-4 h-4 transition-transform @(isExpanded ? "rotate-90" : "")" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                                </svg>
                            </button>
                            <div class="min-w-0">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-semibold text-slate-900 truncate">@printer.Name</span>
                                    @if (snap is not null)
                                    {
                                        @if (snap.SupportsDuplex)
                                        {
                                            <span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-blue-50 text-blue-700 border border-blue-100">DUPLEX</span>
                                        }
                                        @if (snap.SupportsColor)
                                        {
                                            <span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-purple-50 text-purple-700 border border-purple-100">COULEUR</span>
                                        }
                                        @if (snap.SupportsCollation)
                                        {
                                            <span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-amber-50 text-amber-700 border border-amber-100">TRI</span>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="flex items-center gap-2 shrink-0">
                            <button @onclick="() => TestPrinter(printer.Name)" disabled="@isTesting"
                                    class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-lg hover:bg-emerald-100 transition-colors disabled:opacity-50">
                                @if (isTesting)
                                {
                                    <svg class="w-3 h-3 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                                    @:Test…
                                }
                                else
                                {
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                    @:Tester
                                }
                            </button>
                        </div>
                    </div>

                    @* Expanded details *@
                    @if (isExpanded && snap is not null)
                    {
                        <div class="px-4 py-4 border-t border-slate-100 space-y-4">
                            @* Capability overrides *@
                            <div>
                                <h4 class="text-xs font-semibold text-slate-600 uppercase tracking-wide mb-2">Capacités déclarées</h4>
                                <div class="flex flex-wrap gap-3">
                                    @foreach (var (key, label) in CapabilityKeys)
                                    {
                                        var discovered = key switch
                                        {
                                            "Duplex" => snap.SupportsDuplex,
                                            "Color" => snap.SupportsColor,
                                            "Collation" => snap.SupportsCollation,
                                            _ => false
                                        };
                                        var confirmed = caps.TryGetValue(key, out var v) ? (bool?)v : null;

                                        <div class="flex items-center gap-2 text-xs">
                                            <span class="text-slate-700 font-medium">@label</span>
                                            @if (confirmed is true)
                                            {
                                                <span class="px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-200 font-semibold">✓ Confirmé</span>
                                            }
                                            else if (confirmed is false)
                                            {
                                                <span class="px-1.5 py-0.5 rounded bg-red-50 text-red-700 border border-red-200 font-semibold">✗ Infirmé</span>
                                            }
                                            else
                                            {
                                                <span class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-500 border border-slate-200">Non testé</span>
                                            }
                                            <button @onclick="() => OverrideCapability(printer.Name, key, true)"
                                                    disabled="@(confirmed is true)"
                                                    class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-emerald-50 text-emerald-600 border border-emerald-200 hover:bg-emerald-100 disabled:opacity-40 transition-colors"
                                                    title="Confirmer que cette fonctionnalité fonctionne">
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                                            </button>
                                            <button @onclick="() => OverrideCapability(printer.Name, key, false)"
                                                    disabled="@(confirmed is false)"
                                                    class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-red-50 text-red-600 border border-red-200 hover:bg-red-100 disabled:opacity-40 transition-colors"
                                                    title="Marquer comme ne fonctionnant pas">
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                                            </button>
                                        </div>
                                    }
                                    @if (caps.Count > 0)
                                    {
                                        <button @onclick="() => ClearOverrides(printer.Name)"
                                                class="px-2 py-0.5 rounded text-[10px] font-medium text-slate-500 bg-slate-100 border border-slate-200 hover:bg-slate-200 transition-colors">
                                            Réinitialiser
                                        </button>
                                    }
                                </div>
                            </div>

                            @* Paper sizes *@
                            @if (snap.PaperSizes.Count > 0)
                            {
                                <div>
                                    <h4 class="text-xs font-semibold text-slate-600 uppercase tracking-wide mb-2">Formats de papier (@snap.PaperSizes.Count)</h4>
                                    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-1.5 max-h-40 overflow-y-auto">
                                        @foreach (var ps in snap.PaperSizes)
                                        {
                                            <div class="text-[10px] text-slate-600 bg-slate-50 rounded px-2 py-1 border border-slate-100">
                                                <span class="font-medium">@ps.Name</span>
                                                <span class="text-slate-400 ml-1">@ps.WidthMm.ToString("F0")×@ps.HeightMm.ToString("F0")</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            @* Trays *@
                            @if (snap.PaperTrays.Count > 0)
                            {
                                <div>
                                    <h4 class="text-xs font-semibold text-slate-600 uppercase tracking-wide mb-2">Bacs (@snap.PaperTrays.Count)</h4>
                                    <div class="flex flex-wrap gap-1.5">
                                        @foreach (var tray in snap.PaperTrays)
                                        {
                                            <span class="text-[10px] text-slate-600 bg-slate-50 rounded px-2 py-1 border border-slate-100">
                                                @tray.Name <span class="text-slate-400">#@tray.BinNumber</span>
                                            </span>
                                        }
                                    </div>
                                </div>
                            }

                            @* Resolutions *@
                            @if (snap.Resolutions.Count > 0)
                            {
                                <div>
                                    <h4 class="text-xs font-semibold text-slate-600 uppercase tracking-wide mb-2">Résolutions</h4>
                                    <div class="flex flex-wrap gap-1.5">
                                        @foreach (var res in snap.Resolutions)
                                        {
                                            <span class="text-[10px] text-slate-600 bg-slate-50 rounded px-2 py-1 border border-slate-100">
                                                @res.DpiX×@res.DpiY dpi
                                                @if (res.IsDefault)
                                                {
                                                    <span class="text-brand-600 font-bold ml-0.5">(défaut)</span>
                                                }
                                            </span>
                                        }
                                    </div>
                                </div>
                            }

                            @* Profiles *@
                            @if (PrinterProfiles.ContainsKey(printer.Name))
                            {
                                <div>
                                    <h4 class="text-xs font-semibold text-slate-600 uppercase tracking-wide mb-2">Profils générés (@PrinterProfiles[printer.Name].Count)</h4>
                                    <div class="flex flex-wrap gap-1.5">
                                        @foreach (var prof in PrinterProfiles[printer.Name])
                                        {
                                            <span class="text-[10px] text-slate-600 bg-slate-50 rounded px-2 py-1 border border-slate-100">
                                                <span class="font-medium">@prof.Name</span>
                                                @if (prof.IsBooklet)
                                                {
                                                    <span class="text-violet-500 ml-0.5">★</span>
                                                }
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    @* ══════════════════════════════════════════════════════════════════ *@
    @* SECTION 3 : Test Log                                             *@
    @* ══════════════════════════════════════════════════════════════════ *@
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
            <div>
                <h2 class="text-base font-bold text-slate-900">Journal des tests</h2>
                <p class="text-xs text-slate-500 mt-0.5">Résultats des dernières pages de test imprimées</p>
            </div>
            @if (AllConfirmations.Count > 0)
            {
                <button @onclick="ClearAllLogs"
                        class="text-xs text-red-600 hover:text-red-700 font-medium transition-colors">
                    Tout effacer
                </button>
            }
        </div>
        <div class="px-6 py-4">
            @if (AllConfirmations.Count == 0)
            {
                <p class="text-sm text-slate-400">Aucun test enregistré.</p>
            }
            else
            {
                <div class="space-y-2">
                    @foreach (var (printer, caps) in AllConfirmations)
                    {
                        @foreach (var (capKey, capValue) in caps)
                        {
                            <div class="flex items-center gap-3 text-xs">
                                <span class="w-40 font-medium text-slate-700 truncate">@printer</span>
                                <span class="w-24 text-slate-500">@capKey</span>
                                @if (capValue)
                                {
                                    <span class="px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-200 font-semibold">✓ OK</span>
                                }
                                else
                                {
                                    <span class="px-1.5 py-0.5 rounded bg-red-50 text-red-700 border border-red-200 font-semibold">✗ Échec</span>
                                }
                            </div>
                        }
                    }
                </div>
            }
        </div>
    </div>
</div>

@* Toast *@
@if (!string.IsNullOrEmpty(ToastMessage))
{
    <div class="fixed bottom-6 right-6 z-50">
        <div class="@(ToastIsError ? "bg-red-50 border-red-200 text-red-800" : "bg-emerald-50 border-emerald-200 text-emerald-800") border rounded-xl px-5 py-3 shadow-lg flex items-center gap-3">
            <span class="text-sm font-medium">@ToastMessage</span>
            <button @onclick="() => ToastMessage = null" class="ml-2 text-current opacity-50 hover:opacity-100">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
        </div>
    </div>
}

@* Test confirmation dialog *@
@if (ShowTestConfirmDialog)
{
    <div class="fixed inset-0 bg-black/40 z-50 flex items-center justify-center p-4" @onclick="CancelTestConfirm">
        <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6" @onclick:stopPropagation="true">
            <h3 class="text-lg font-bold text-slate-900 mb-2">Page de test imprimée</h3>
            <p class="text-sm text-slate-600 mb-1">La page de test a été envoyée à <strong>@PendingTestPrinterName</strong>.</p>
            <p class="text-sm text-slate-600 mb-6">Avez-vous reçu le document imprimé ?</p>
            <div class="flex items-center gap-3 justify-end">
                <button @onclick="CancelTestConfirm"
                        class="px-4 py-2 text-sm font-medium text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors">
                    Annuler
                </button>
                <button @onclick="ConfirmTestFailed"
                        class="px-4 py-2 text-sm font-medium text-red-700 bg-red-50 hover:bg-red-100 border border-red-200 rounded-lg transition-colors">
                    Non, échoué
                </button>
                <button @onclick="ConfirmTestSuccess"
                        class="px-4 py-2 text-sm font-medium text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg transition-colors shadow-sm">
                    Oui, fonctionne
                </button>
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<FocusMed.Printing.Discovery.InstalledPrinter> InstalledPrinters = [];
    private Dictionary<string, FocusMed.Printing.Discovery.PrinterCapabilitySnapshot> Snapshots = new();
    private Dictionary<string, IReadOnlyList<FocusMed.Printing.Profiles.PrintProfile>> PrinterProfiles = new();
    private Dictionary<string, Dictionary<string, bool>> Confirmations = new();
    private Dictionary<string, Dictionary<string, bool>> AllConfirmations = new();

    private string? ExpandedPrinter;
    private string? TestingPrinter;
    private string? PendingTestJobId;
    private string? PendingTestPrinterName;
    private bool ShowTestConfirmDialog;
    private string? SelectedDefaultPrinter;
    private string? SelectedDefaultProfile;
    private int SelectedDefaultCopies = 1;
    private List<FocusMed.Printing.Profiles.PrintProfile> DefaultProfiles = new();
    private string? SettingsStatus;
    private bool SettingsSaved;
    private string? ToastMessage;
    private bool ToastIsError;

    private static readonly (string Key, string Label)[] CapabilityKeys =
    [
        (FocusMed.Printing.Discovery.ConfirmationKeys.Duplex, "Duplex"),
        (FocusMed.Printing.Discovery.ConfirmationKeys.Color, "Couleur"),
        (FocusMed.Printing.Discovery.ConfirmationKeys.Collation, "Tri")
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadAll();
    }

    private async Task LoadAll()
    {
        var printers = new List<FocusMed.Printing.Discovery.InstalledPrinter>(DiscoveryService.GetAvailablePrinters());

        // Add raw TCP printers (Konica bizhub, etc.) from config
        foreach (var raw in RawPrinterOptions.Value.Printers)
        {
            if (!printers.Any(p => p.Name.Equals(raw.Name, StringComparison.OrdinalIgnoreCase)))
                printers.Add(new FocusMed.Printing.Discovery.InstalledPrinter(raw.Name));
        }

        InstalledPrinters = printers;
        Snapshots.Clear();
        PrinterProfiles.Clear();
        Confirmations.Clear();

        foreach (var printer in InstalledPrinters)
        {
            try
            {
                // Skip raw TCP printers for capability discovery (they're not Windows printers)
                if (RawPrinterOptions.Value.Printers.Any(p => p.Name.Equals(printer.Name, StringComparison.OrdinalIgnoreCase)))
                {
                    var rawPreset = RawPrinterOptions.Value.Printers.First(p => p.Name.Equals(printer.Name, StringComparison.OrdinalIgnoreCase));
                    var (wMm, hMm) = rawPreset.PaperSize?.ToUpperInvariant() switch
                    {
                        "A3" => (297.0f, 420.0f),
                        "A4" => (210.0f, 297.0f),
                        "A5" => (148.0f, 210.0f),
                        "LETTER" => (215.9f, 279.4f),
                        "LEGAL" => (215.9f, 355.6f),
                        _ => (0.0f, 0.0f)
                    };
                    Snapshots[printer.Name] = new FocusMed.Printing.Discovery.PrinterCapabilitySnapshot
                    {
                        PrinterName = printer.Name,
                        DriverName = "RAW TCP",
                        SupportsDuplex = false,
                        SupportsColor = !rawPreset.ForceGrayscale,
                        PaperSizes = [new FocusMed.Printing.Discovery.PaperSizeInfo { Name = rawPreset.PaperSize, WidthMm = wMm, HeightMm = hMm }]
                    };
                    PrinterProfiles[printer.Name] =
                    [
                        new FocusMed.Printing.Profiles.PrintProfile
                        {
                            Name = rawPreset.IsBooklet ? $"Booklet {rawPreset.PaperSize}" : $"Simple {rawPreset.PaperSize}",
                            Description = rawPreset.IsBooklet ? $"Livret {rawPreset.PaperSize} (TCP RAW)" : $"Recto simple {rawPreset.PaperSize} (TCP RAW)",
                            IsBooklet = rawPreset.IsBooklet,
                            PaperSizeName = rawPreset.PaperSize,
                            ForceGrayscale = rawPreset.ForceGrayscale
                        }
                    ];
                    continue;
                }

                var snap = await CapabilityService.GetSnapshotAsync(printer.Name);
                Snapshots[printer.Name] = snap;
                PrinterProfiles[printer.Name] = ProfileBuilder.BuildProfiles(snap);
                Confirmations[printer.Name] = await ConfirmationStore.GetAllAsync(printer.Name);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to load data for '{Printer}'", printer.Name);
            }
        }

        AllConfirmations.Clear();
        foreach (var printer in InstalledPrinters)
        {
            if (Confirmations.TryGetValue(printer.Name, out var caps) && caps.Count > 0)
                AllConfirmations[printer.Name] = new(caps);
        }

        var saved = await SettingsStore.LoadAsync();
        SelectedDefaultPrinter = saved.DefaultPrinterName;
        SelectedDefaultProfile = saved.DefaultProfileName;
        SelectedDefaultCopies = saved.DefaultCopies;
        await OnDefaultPrinterChanged();

        StateHasChanged();
    }

    private async Task OnDefaultPrinterChanged()
    {
        if (string.IsNullOrEmpty(SelectedDefaultPrinter) || !Snapshots.TryGetValue(SelectedDefaultPrinter, out var snap))
        {
            DefaultProfiles = new();
            return;
        }
        DefaultProfiles = ProfileBuilder.BuildProfiles(snap).ToList();
        if (!string.IsNullOrEmpty(SelectedDefaultProfile) && DefaultProfiles.Any(p => p.Name == SelectedDefaultProfile))
        {
            // keep current selection
        }
        else
        {
            SelectedDefaultProfile = DefaultProfiles.FirstOrDefault()?.Name;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveDefaultSettings()
    {
        await SettingsStore.SaveAsync(new FocusMed.Printing.Profiles.PrintSettings
        {
            DefaultPrinterName = SelectedDefaultPrinter,
            DefaultProfileName = SelectedDefaultProfile,
            DefaultCopies = SelectedDefaultCopies
        });
        SettingsStatus = "Enregistré";
        SettingsSaved = true;
        ShowToast("Paramètres enregistrés", false);
        StateHasChanged();
        _ = DelayThenResetStatus();
    }

    private void ToggleExpand(string name)
    {
        ExpandedPrinter = ExpandedPrinter == name ? null : name;
    }

    private async Task TestPrinter(string printerName)
    {
        TestingPrinter = printerName;
        StateHasChanged();
        try
        {
            var jobId = await TestPageService.PrintTestPageAsync(printerName, "General Print Test");
            PendingTestJobId = jobId;
            PendingTestPrinterName = printerName;
            ShowTestConfirmDialog = true;
            ShowToast($"Page de test envoyée à '{printerName}'. Avez-vous reçu le document ?", false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Test failed for '{Printer}'", printerName);
            ShowToast($"Échec du test: {ex.Message}", true);
        }
        finally
        {
            TestingPrinter = null;
            StateHasChanged();
        }
    }

    private async Task ConfirmTestSuccess()
    {
        if (PendingTestJobId is null || PendingTestPrinterName is null) return;

        var snap = Snapshots.GetValueOrDefault(PendingTestPrinterName);
        var keys = new List<string>();
        if (snap?.SupportsDuplex == true) keys.Add(FocusMed.Printing.Discovery.ConfirmationKeys.Duplex);
        if (snap?.SupportsColor == true) keys.Add(FocusMed.Printing.Discovery.ConfirmationKeys.Color);
        if (snap?.SupportsCollation == true) keys.Add(FocusMed.Printing.Discovery.ConfirmationKeys.Collation);

        foreach (var key in keys)
        {
            await ConfirmationStore.SaveAsync(PendingTestPrinterName, key, true);
            if (!Confirmations.ContainsKey(PendingTestPrinterName))
                Confirmations[PendingTestPrinterName] = new();
            Confirmations[PendingTestPrinterName][key] = true;
            if (!AllConfirmations.ContainsKey(PendingTestPrinterName))
                AllConfirmations[PendingTestPrinterName] = new();
            AllConfirmations[PendingTestPrinterName][key] = true;
        }

        if (snap is not null)
        {
            var updatedSnap = await CapabilityService.GetSnapshotAsync(PendingTestPrinterName);
            Snapshots[PendingTestPrinterName] = updatedSnap;
            PrinterProfiles[PendingTestPrinterName] = ProfileBuilder.BuildProfiles(updatedSnap);
        }

        ShowToast($"Capacités confirmées pour '{PendingTestPrinterName}'", false);
        CleanupTestState();
        StateHasChanged();
    }

    private async Task ConfirmTestFailed()
    {
        if (PendingTestJobId is null || PendingTestPrinterName is null) return;

        var snap = Snapshots.GetValueOrDefault(PendingTestPrinterName);
        var keys = new List<string>();
        if (snap?.SupportsDuplex == true) keys.Add(FocusMed.Printing.Discovery.ConfirmationKeys.Duplex);
        if (snap?.SupportsColor == true) keys.Add(FocusMed.Printing.Discovery.ConfirmationKeys.Color);
        if (snap?.SupportsCollation == true) keys.Add(FocusMed.Printing.Discovery.ConfirmationKeys.Collation);

        foreach (var key in keys)
        {
            await ConfirmationStore.SaveAsync(PendingTestPrinterName, key, false);
            if (!Confirmations.ContainsKey(PendingTestPrinterName))
                Confirmations[PendingTestPrinterName] = new();
            Confirmations[PendingTestPrinterName][key] = false;
            if (!AllConfirmations.ContainsKey(PendingTestPrinterName))
                AllConfirmations[PendingTestPrinterName] = new();
            AllConfirmations[PendingTestPrinterName][key] = false;
        }

        if (snap is not null)
        {
            var updatedSnap = await CapabilityService.GetSnapshotAsync(PendingTestPrinterName);
            Snapshots[PendingTestPrinterName] = updatedSnap;
            PrinterProfiles[PendingTestPrinterName] = ProfileBuilder.BuildProfiles(updatedSnap);
        }

        ShowToast($"Capacités marquées comme non fonctionnelles pour '{PendingTestPrinterName}'", false);
        CleanupTestState();
        StateHasChanged();
    }

    private void CancelTestConfirm()
    {
        CleanupTestState();
        StateHasChanged();
    }

    private void CleanupTestState()
    {
        PendingTestJobId = null;
        PendingTestPrinterName = null;
        ShowTestConfirmDialog = false;
    }

    private async Task OverrideCapability(string printerName, string key, bool value)
    {
        await ConfirmationStore.SaveAsync(printerName, key, value);
        if (!Confirmations.ContainsKey(printerName))
            Confirmations[printerName] = new();
        Confirmations[printerName][key] = value;

        if (!AllConfirmations.ContainsKey(printerName))
            AllConfirmations[printerName] = new();
        AllConfirmations[printerName][key] = value;

        // Re-snapshot and rebuild profiles with updated confirmation
        var updatedSnap = await CapabilityService.GetSnapshotAsync(printerName);
        Snapshots[printerName] = updatedSnap;
        PrinterProfiles[printerName] = ProfileBuilder.BuildProfiles(updatedSnap);

        ShowToast($"{key} marqué comme {(value ? "confirmé" : "infirmé")} pour '{printerName}'", false);
        StateHasChanged();
    }

    private async Task ClearOverrides(string printerName)
    {
        await ConfirmationStore.RemoveAllAsync(printerName);
        Confirmations[printerName] = new();
        AllConfirmations[printerName] = new();

        // Re-snapshot and rebuild profiles with cleared confirmations
        var updatedSnap = await CapabilityService.GetSnapshotAsync(printerName);
        Snapshots[printerName] = updatedSnap;
        PrinterProfiles[printerName] = ProfileBuilder.BuildProfiles(updatedSnap);

        ShowToast("Réinitialisé pour '" + printerName + "'", false);
        StateHasChanged();
    }

    private async Task ClearAllLogs()
    {
        foreach (var printer in InstalledPrinters)
        {
            await ConfirmationStore.RemoveAllAsync(printer.Name);
        }
        Confirmations.Clear();
        AllConfirmations.Clear();

        // Re-snapshot and rebuild all profiles
        foreach (var printer in InstalledPrinters)
        {
            var updatedSnap = await CapabilityService.GetSnapshotAsync(printer.Name);
            Snapshots[printer.Name] = updatedSnap;
            PrinterProfiles[printer.Name] = ProfileBuilder.BuildProfiles(updatedSnap);
        }

        ShowToast("Journal effacé", false);
        StateHasChanged();
    }

    private async Task RefreshAll()
    {
        await LoadAll();
        ShowToast("Rafraîchi", false);
    }

    private void ShowToast(string msg, bool error)
    {
        ToastMessage = msg;
        ToastIsError = error;
        StateHasChanged();
        _ = DelayThenResetToast();
    }

    private async Task DelayThenResetStatus()
    {
        try
        {
            await Task.Delay(3000);
            SettingsStatus = null;
            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    private async Task DelayThenResetToast()
    {
        try
        {
            await Task.Delay(4000);
            ToastMessage = null;
            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }
}

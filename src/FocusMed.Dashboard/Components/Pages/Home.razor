@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject Microsoft.EntityFrameworkCore.IDbContextFactory<FocusMedDbContext> DbFactory
@inject NavigationManager Navigation
@inject ILogger<Home> Logger
@inject Services.StudyService StudyService
@inject FocusMed.Dicom.IStudyNotificationService NotificationService




<PageTitle>Études — FocusMed</PageTitle>

<div class="flex flex-col flex-1 min-w-0 gap-5">
<!-- Page Header -->
<div class="flex items-center justify-between">
    <div>
        <h2 class="text-lg font-bold text-slate-900">Études</h2>
        <p class="text-xs text-slate-500 mt-0.5">
            <span class="text-slate-700 font-bold">@TotalCount</span> étude@((TotalCount) != 1 ? "s" : "")
            @if (HasActiveFilters && TotalCount > 0)
            {
                <span class="text-slate-400">(filtré)</span>
            }
        </p>
    </div>
    <div class="flex items-center gap-2">
        <a href="/archives" class="inline-flex items-center gap-1.5 px-3 py-2 text-xs font-semibold text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 shadow-sm transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" /></svg>
            Archives
        </a>
    </div>
</div>

<!-- Filters -->
<div class="flex items-center gap-3 flex-wrap">
    <!-- Search -->
    <div class="relative flex-1 min-w-[200px] max-w-sm">
        <svg class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input type="text" @bind="SearchTerm" @bind:event="oninput" @bind:after="OnFilterChanged"
               placeholder="Rechercher un patient…"
               disabled="@IsLoading"
               class="w-full pl-10 pr-4 py-2 text-sm bg-white border border-slate-200 rounded-lg text-slate-900 placeholder-slate-400 shadow-sm focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500/40 transition-all disabled:opacity-50 disabled:cursor-not-allowed" />
    </div>

    <!-- Date -->
    <div class="flex items-center gap-2">
        <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Date</label>
        <input type="date" @bind="SelectedDate" @bind:after="OnFilterChanged"
               disabled="@IsLoading"
               class="px-3 py-2 text-sm bg-white border border-slate-200 rounded-lg text-slate-700 shadow-sm focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500/40 transition-all disabled:opacity-50 disabled:cursor-not-allowed" />
        @if (SelectedDate.HasValue)
        {
            <button @onclick="ClearDateFilter" class="px-2 py-2 text-xs font-semibold text-slate-500 hover:text-red-600 bg-slate-100 rounded-lg hover:bg-red-50 transition-colors" title="Effacer la date">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
        }
    </div>

    <!-- Modality Filter -->
    <div class="flex items-center gap-2">
        <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Modalité</label>
        <select @bind="SelectedModality" @bind:after="OnFilterChanged" disabled="@IsLoading"
                class="px-3 py-2 text-sm bg-white border border-slate-200 rounded-lg text-slate-700 shadow-sm focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500/40 transition-all disabled:opacity-50 disabled:cursor-not-allowed">
            <option value="">Toutes</option>
            @foreach (var mod in AvailableModalities)
            {
                <option value="@mod">@mod</option>
            }
        </select>
    </div>

    <!-- Status Filter -->
    <div class="flex items-center gap-2">
        <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Statut</label>
        <select @bind="SelectedStatus" @bind:after="OnFilterChanged" disabled="@IsLoading"
                class="px-3 py-2 text-sm bg-white border border-slate-200 rounded-lg text-slate-700 shadow-sm focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500/40 transition-all disabled:opacity-50 disabled:cursor-not-allowed">
            <option value="">Tous</option>
            <option value="Receiving">Réception</option>
            <option value="Complete">Terminé</option>
            <option value="Failed">Échoué</option>
        </select>
    </div>

    <!-- Clear All -->
    @if (HasActiveFilters)
    {
        <button @onclick="ClearAllFilters" disabled="@IsLoading" class="px-3 py-2 text-xs font-semibold text-red-600 bg-red-50 rounded-lg hover:bg-red-100 border border-slate-300 shadow-sm transition-colors focus:outline-none focus:ring-2 focus:ring-brand-500/40 disabled:opacity-50 disabled:cursor-not-allowed">
            Effacer filtres
        </button>
    }
</div>

<!-- Data table -->
@if (Studies == null)
{
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="px-4 sm:px-6 py-4 border-b border-slate-100 flex flex-wrap gap-4">
            <div class="h-4 bg-slate-200 rounded w-12 animate-pulse"></div>
            <div class="h-4 bg-slate-200 rounded w-32 animate-pulse"></div>
            <div class="h-4 bg-slate-200 rounded w-24 animate-pulse"></div>
        </div>
        <div class="divide-y divide-slate-100">
            @for (int i = 0; i < 5; i++)
            {
                <div class="px-4 sm:px-6 py-4 flex items-center justify-between flex-wrap gap-2">
                    <div class="flex items-center gap-4 w-full">
                        <div class="h-6 bg-slate-100 rounded w-8 animate-pulse"></div>
                        <div class="h-4 bg-slate-200 rounded w-48 animate-pulse"></div>
                        <div class="h-4 bg-slate-100 rounded w-24 animate-pulse ml-auto"></div>
                        <div class="h-6 bg-slate-100 rounded-full w-16 animate-pulse ml-8"></div>
                    </div>
                </div>
            }
        </div>
    </div>
}
else if (Studies is not null && Studies.Count == 0)
{
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-12 text-center">
        <div class="mx-auto w-12 h-12 bg-slate-50 rounded-full flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
            </svg>
        </div>
        <h3 class="text-sm font-semibold text-slate-900">Aucune étude trouvée</h3>
        <p class="text-sm text-slate-500 mt-1">Il n'y a aucune étude DICOM correspondant à vos critères.</p>
    </div>
}
else
{
    <div class="flex-1 min-h-0 flex flex-col bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="overflow-auto flex-1 min-h-0">
            <table class="w-full text-left text-sm">
                <thead class="sticky top-0 z-10 bg-slate-50/50 text-slate-500 font-semibold text-xs uppercase tracking-wider border-b border-slate-200">
                    <tr>
                        <th class="px-4 sm:px-6 py-4 cursor-pointer hover:text-slate-700 select-none" @onclick='() => ToggleSort("id")'>
                            <span class="inline-flex items-center gap-1">ID @SortIcon("id")</span>
                        </th>
                        <th class="px-4 sm:px-6 py-4 cursor-pointer hover:text-slate-700 select-none" @onclick='() => ToggleSort("patient")'>
                            <span class="inline-flex items-center gap-1">Nom Patient @SortIcon("patient")</span>
                        </th>
                        <th class="px-4 sm:px-6 py-4 cursor-pointer hover:text-slate-700 select-none" @onclick='() => ToggleSort("date")'>
                            <span class="inline-flex items-center gap-1">Date @SortIcon("date")</span>
                        </th>
                        <th class="px-4 sm:px-6 py-4">Modalité</th>
                        <th class="px-4 sm:px-6 py-4">Images</th>
                        <th class="px-4 sm:px-6 py-4 cursor-pointer hover:text-slate-700 select-none" @onclick='() => ToggleSort("status")'>
                            <span class="inline-flex items-center gap-1">Statut @SortIcon("status")</span>
                        </th>
                        <th class="px-4 sm:px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var study in Studies!)
                    {
                        var modalities = study.Series.Select(s => s.Modality).Distinct().ToList();
                        var modalityDisplay = modalities.Any() ? string.Join(", ", modalities) : "N/A";
                        var patientName = string.IsNullOrWhiteSpace(study.Patient?.PatientName) ? "Inconnu" : study.Patient.PatientName.Replace("^", " ");
                        var imageCount = _imageCounts.GetValueOrDefault(study.Id, 0);
                        <tr class="hover:bg-slate-50/80 transition-colors group">
                            <td class="px-4 sm:px-6 py-3.5 text-slate-500">
                                <span class="bg-slate-100 text-slate-600 px-2.5 py-1 rounded text-xs font-mono">@study.Id</span>
                            </td>
                            <td class="px-4 sm:px-6 py-3.5 font-bold text-slate-900 max-w-[200px] truncate" title="@patientName">@patientName</td>
                            <td class="px-4 sm:px-6 py-3.5 text-slate-500 whitespace-nowrap">@(study.StudyDate?.ToString("dd/MM/yyyy") ?? study.CreatedAt.ToString("dd/MM/yyyy"))</td>
                            <td class="px-4 sm:px-6 py-3.5">
                                <span class="inline-flex items-center px-2.5 py-1 rounded text-xs font-bold bg-slate-100 text-slate-700">
                                    @modalityDisplay
                                </span>
                            </td>
                            <td class="px-4 sm:px-6 py-3.5 text-slate-500 text-xs">
                                @imageCount image@(imageCount != 1 ? "s" : "")
                            </td>
                            <td class="px-4 sm:px-6 py-3.5">
                                @if (study.Status == StudyStatus.Complete)
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-100">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Terminé
                                    </span>
                                }
                                else if (study.Status == StudyStatus.Receiving)
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded text-xs font-medium bg-blue-50 text-blue-700 border border-blue-100">
                                        <span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse"></span> Réception
                                    </span>
                                }
                                else if (study.Status == StudyStatus.Failed)
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded text-xs font-medium bg-red-50 text-red-700 border border-red-100">
                                        <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span> Échoué
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded text-xs font-medium bg-slate-50 text-slate-700 border border-slate-100">
                                        @study.Status
                                    </span>
                                }
                            </td>
                            <td class="px-4 sm:px-6 py-3.5 text-right" @onclick:stopPropagation="true">
                                <div class="flex items-center justify-end gap-2">
                                    <button class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-semibold text-brand-700 bg-brand-50 rounded-lg hover:bg-brand-100 border border-brand-100 transition-colors shadow-sm" title="Ouvrir"
                                            @onclick="() => OpenStudy(study.Id)">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                                        Ouvrir
                                    </button>
                                    <button disabled="@IsProcessing"
                                            @onclick="() => OpenMergePicker(study)"
                                            class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-semibold text-purple-700 bg-purple-50 rounded-lg hover:bg-purple-100 border border-purple-100 transition-colors disabled:opacity-50 shadow-sm" title="Fusionner">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" /></svg>
                                        Fusionner
                                    </button>
                                    @if (study.Status == StudyStatus.Receiving)
                                    {
                                        <button disabled="@IsProcessing"
                                                class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-semibold text-emerald-700 bg-emerald-50 rounded-lg hover:bg-emerald-100 border border-emerald-100 transition-colors disabled:opacity-50 shadow-sm" title="Marquer terminé"
                                                @onclick="() => MarkComplete(study)">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                                            Terminé
                                        </button>
                                    }
                                    <button disabled="@IsProcessing"
                                            class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-semibold text-amber-700 bg-amber-50 rounded-lg hover:bg-amber-100 border border-amber-100 transition-colors disabled:opacity-50 shadow-sm" title="Archiver"
                                            @onclick="() => ArchiveStudy(study)">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" /></svg>
                                        Archiver
                                    </button>
                                    <button disabled="@IsProcessing"
                                            class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-semibold text-slate-600 bg-slate-100 rounded-lg hover:bg-slate-200 border border-slate-200 transition-colors disabled:opacity-50 shadow-sm" title="Supprimer"
                                            @onclick="() => SoftDeleteStudy(study)">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                        Supprimer
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="px-4 sm:px-6 py-4 border-t border-slate-100 bg-slate-50/50 flex items-center justify-between flex-wrap gap-2 shrink-0">
            <span class="text-xs text-slate-500 font-medium">
                Page <span class="text-slate-700 font-bold">@CurrentPage</span> / <span class="text-slate-700 font-bold">@TotalPages</span>
            </span>
            <div class="flex items-center gap-1">
                <button disabled="@(CurrentPage <= 1)" @onclick="PreviousPage"
                        class="@($"px-3 py-1.5 rounded-md text-xs font-semibold transition-colors {(CurrentPage <= 1 ? "text-slate-300 bg-slate-50 cursor-not-allowed" : "text-slate-600 bg-white border border-slate-200 hover:bg-slate-100 shadow-sm")}")">
                    ← Précédent
                </button>
                <button disabled="@(CurrentPage >= TotalPages)" @onclick="NextPage"
                        class="@($"px-3 py-1.5 rounded-md text-xs font-semibold transition-colors {(CurrentPage >= TotalPages ? "text-slate-300 bg-slate-50 cursor-not-allowed" : "text-slate-600 bg-white border border-slate-200 hover:bg-slate-100 shadow-sm")}")">
                    Suivant →
                </button>
            </div>
        </div>
    </div>
}
</div>

<!-- Delete Confirmation Modal -->
<ConfirmModal IsVisible="StudyToDelete != null"
              Title="Supprimer cette étude ?"
              Message="@($"L'étude de {DicomHelpers.FormatPatientName(StudyToDelete?.Patient?.PatientName)} sera supprimée définitivement. Cette action est irréversible.")"
              ConfirmText="Supprimer"
              OnConfirm="ExecuteSoftDelete"
              OnCancel="CancelDelete" />

<!-- Merge: target-study picker -->
@if (ShowMergePicker)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center" role="dialog" aria-modal="true" aria-label="Choisir l'étude de destination">
        <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm" @onclick="CancelMergePicker"></div>
        <div class="relative w-full max-w-lg mx-auto z-50">
            <div class="bg-white rounded-xl shadow-2xl overflow-hidden">
                <div class="p-5 border-b border-slate-100">
                    <h3 class="text-base font-bold text-slate-900">Fusionner « @(DicomHelpers.FormatPatientName(MergeSource?.Patient?.PatientName)) »</h3>
                    <p class="text-xs text-slate-500 mt-1">Choisissez l'étude de destination : les images seront déplacées vers elle, puis l'étude source sera supprimée.</p>
                </div>
                <div class="max-h-80 overflow-y-auto p-3 space-y-2">
                    @if (MergeCandidates.Count == 0)
                    {
                        <div class="text-sm text-slate-400 text-center py-8">Aucune autre étude disponible.</div>
                    }
                    @foreach (var c in MergeCandidates)
                    {
                        <button @onclick="() => SelectMergeTarget(c)"
                                class="w-full flex items-center justify-between gap-3 p-3 rounded-xl border border-slate-200 hover:border-brand-300 hover:bg-brand-50 transition-colors text-left">
                            <div class="min-w-0">
                                <div class="text-sm font-bold text-slate-800 truncate">@c.PatientName</div>
                                <div class="text-xs text-slate-500">@c.StudyDate · @c.Modality · @c.ImageCount image(s)</div>
                            </div>
                            <span class="text-xs font-bold text-brand-600 shrink-0">← Fusionner ici</span>
                        </button>
                    }
                </div>
                <div class="flex border-t border-slate-100">
                    <button @onclick="CancelMergePicker" class="flex-1 px-4 py-3 text-sm font-semibold text-slate-600 hover:bg-slate-50 transition-colors rounded-lg">Annuler</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Merge: confirm modal -->
<ConfirmModal IsVisible="MergeTarget != null && MergeSource != null"
              Title="Confirmer la fusion"
              Message="@(MergeConfirmMessage)"
              ConfirmText="Oui, fusionner"
              CancelText="Annuler"
              ConfirmClass="text-white bg-brand-600 hover:bg-brand-700"
              IconBgClass="bg-brand-50"
              IconClass="text-brand-500"
              IconPath="M4 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2H4zm12-2v2h2v8h-2v2h1a2 2 0 002-2V5a2 2 0 00-2-2h-1z"
              OnConfirm="ConfirmMerge"
              OnCancel="CancelMerge" />

<!-- Toast notification -->
<ToastNotification Message="@StatusMessage" IsError="@IsError" OnDismiss="ClearToast" />
@code {
    // Current page only — filtering, ordering and paging all run in SQLite.
    private List<Study>? Studies;
    private Dictionary<int, int> _imageCounts = new();
    private int TotalCount;

    private string SearchTerm { get; set; } = "";
    private DateTime? SelectedDate { get; set; } = DateTime.Today;
    private string SelectedModality { get; set; } = "";
    private string SelectedStatus { get; set; } = "";

    private int CurrentPage = 1;
    private const int PageSize = 50;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TotalCount / (double)PageSize));

    private Study? StudyToDelete;
    private bool IsProcessing;
    private bool IsLoading;
    private bool HasActiveFilters => SelectedDate.HasValue || !string.IsNullOrWhiteSpace(SearchTerm) || !string.IsNullOrEmpty(SelectedModality) || !string.IsNullOrEmpty(SelectedStatus);

    private List<string> AvailableModalities = [];
    private string StatusMessage = "";
    private bool IsError = false;

    // ---- Merge state ----
    private sealed record MergeCandidateRow(int StudyId, string PatientName, string StudyDate, string Modality, int ImageCount);
    private Study? MergeSource;
    private bool ShowMergePicker;
    private List<MergeCandidateRow> MergeCandidates = new();
    private MergeCandidateRow? MergeTarget;
    private bool IsMerging;
    private string MergeConfirmMessage => MergeTarget == null || MergeSource == null
        ? ""
        : $"Les images de « {DicomHelpers.FormatPatientName(MergeSource.Patient?.PatientName)} » seront déplacées dans « {MergeTarget.PatientName} ». L'étude source sera supprimée. Continuer ?";


    protected override async Task OnInitializedAsync()
    {
        NotificationService.OnStudyChanged += HandleStudyChanged;
        await LoadDataAsync();
    }

    private async void HandleStudyChanged()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                await LoadDataAsync();
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error handling study change notification");
        }
    }

    private IQueryable<Study> BuildFilteredQuery(FocusMedDbContext db)
    {
        var query = db.Studies
            .Where(s => s.Status != StudyStatus.Archived && s.Status != StudyStatus.Deleted);

        if (!string.IsNullOrWhiteSpace(SearchTerm))
        {
            var term = SearchTerm.Trim();
            query = query.Where(s =>
                EF.Functions.Like((s.Patient!.PatientName ?? "").Replace("^", " "), $"%{term}%"));
        }

        if (SelectedDate.HasValue)
        {
            var date = SelectedDate.Value.Date;
            query = query.Where(s =>
                s.CreatedAt.Date == date ||
                (s.StudyDate.HasValue && s.StudyDate.Value.Date == date) ||
                s.LastUpdatedAt.Date == date);
        }

        if (!string.IsNullOrEmpty(SelectedModality))
            query = query.Where(s => s.Series.Any(se => se.Modality == SelectedModality));

        if (!string.IsNullOrEmpty(SelectedStatus)
            && Enum.TryParse<StudyStatus>(SelectedStatus, out var status))
            query = query.Where(s => s.Status == status);

        return query;
    }

    private async Task LoadDataAsync()
    {
        IsLoading = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var filtered = BuildFilteredQuery(db);
            TotalCount = await filtered.CountAsync();

        // Clamp BEFORE materializing so deleting the last row(s) of the final page
        // re-queries the now-correct page instead of showing stale rows.
        var totalPages = Math.Max(1, (int)Math.Ceiling(TotalCount / (double)PageSize));
        if (CurrentPage > totalPages) CurrentPage = totalPages;

        var pageQuery = ApplySort(filtered);

        Studies = await pageQuery
            .Include(s => s.Patient)
            .Include(s => s.Series)
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToListAsync();

        // Image counts scoped to the visible page instead of the whole archive.
        var pageIds = Studies.Select(s => s.Id).ToList();
        _imageCounts = await db.DicomImages
            .Where(d => db.Series.Where(sr => pageIds.Contains(sr.StudyId)).Select(sr => sr.Id).Contains(d.SeriesId))
            .GroupBy(d => d.Series.StudyId)
            .Select(g => new { StudyId = g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.StudyId, x => x.Count);

        AvailableModalities = await db.Series
            .Where(se => se.Study != null && se.Study.Status != StudyStatus.Archived && se.Study.Status != StudyStatus.Deleted)
            .Where(se => se.Modality != null && se.Modality != "")
            .Select(se => se.Modality!)
            .Distinct()
            .OrderBy(m => m)
            .ToListAsync();
        }
        finally
        {
            IsLoading = false;
        }
    }

    private IQueryable<Study> ApplySort(IQueryable<Study> query)
    {
        return SortColumn switch
        {
            "id" => SortDescending
                ? query.OrderByDescending(s => s.Id).ThenByDescending(s => s.LastUpdatedAt)
                : query.OrderBy(s => s.Id).ThenByDescending(s => s.LastUpdatedAt),
            "patient" => SortDescending
                ? query.OrderByDescending(s => s.Patient!.PatientName).ThenByDescending(s => s.LastUpdatedAt)
                : query.OrderBy(s => s.Patient!.PatientName).ThenByDescending(s => s.LastUpdatedAt),
            "date" => SortDescending
                ? query.OrderByDescending(s => s.StudyDate ?? s.CreatedAt).ThenByDescending(s => s.LastUpdatedAt)
                : query.OrderBy(s => s.StudyDate ?? s.CreatedAt).ThenByDescending(s => s.LastUpdatedAt),
            "status" => SortDescending
                ? query.OrderByDescending(s => s.Status).ThenByDescending(s => s.LastUpdatedAt)
                : query.OrderBy(s => s.Status).ThenByDescending(s => s.LastUpdatedAt),
            _ => query.OrderByDescending(s => s.LastUpdatedAt)
        };
    }

    private string SortColumn { get; set; } = "";
    private bool SortDescending = true;

    private MarkupString SortIcon(string column) => SortColumn switch
    {
        var c when c == column && SortDescending => new MarkupString(
            "<svg class=\"w-3 h-3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M5 15l7-7 7 7\" /></svg>"),
        var c when c == column => new MarkupString(
            "<svg class=\"w-3 h-3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\" style=\"transform: rotate(180deg)\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M5 15l7-7 7 7\" /></svg>"),
        _ => new MarkupString(
            "<svg class=\"w-3 h-3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M5 15l7-7 7 7\" /><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M19 9l-7 7-7-7\" /></svg>")
    };

    private async Task ToggleSort(string column)
    {
        if (SortColumn == column)
        {
            if (SortDescending) { SortDescending = false; }
            else { SortColumn = ""; SortDescending = true; } // third click: back to default
        }
        else
        {
            SortColumn = column;
            SortDescending = true;
        }
        await LoadDataAsync();
    }


    private void OpenStudy(int id) => Navigation.NavigateTo($"/study/{id}");

    private async Task PreviousPage()
    {
        if (CurrentPage > 1) { CurrentPage--; await LoadDataAsync(); }
    }

    private async Task NextPage()
    {
        if (CurrentPage < TotalPages) { CurrentPage++; await LoadDataAsync(); }
    }

    private async Task MarkComplete(Study study)
    {
        IsProcessing = true;
        StateHasChanged();
        try
        {
            await StudyService.MarkCompleteAsync(study.Id);
            await LoadDataAsync();
            await ShowToast("Étude marquée comme terminée");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to mark study complete");
            await ShowToast("Erreur lors de la mise à jour", true);
        }
        finally { IsProcessing = false; }
    }

    private async Task ArchiveStudy(Study study)
    {
        IsProcessing = true;
        StateHasChanged();
        try
        {
            await StudyService.ArchiveStudyAsync(study.Id);
            await LoadDataAsync();
            await ShowToast("Étude archivée");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to archive study");
            await ShowToast("Erreur lors de l'archivage", true);
        }
        finally { IsProcessing = false; }
    }

    private void SoftDeleteStudy(Study study) => StudyToDelete = study;
    private void CancelDelete() => StudyToDelete = null;

    private async Task ExecuteSoftDelete()
    {
        if (StudyToDelete == null) return;
        IsProcessing = true;
        StateHasChanged();
        try
        {
            await StudyService.SoftDeleteStudyAsync(StudyToDelete.Id);
            StudyToDelete = null;
            await LoadDataAsync();
            await ShowToast("Étude déplacée vers la corbeille");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to soft delete study");
            await ShowToast("Erreur lors de la suppression", true);
        }
        finally { IsProcessing = false; }
    }



    private async Task OpenMergePicker(Study study)
    {
        MergeSource = study;
        ShowMergePicker = true;
        await InvokeAsync(StateHasChanged);

        using var db = await DbFactory.CreateDbContextAsync();
        var candidates = await db.Studies
            .Where(s => s.Id != study.Id && s.Status != StudyStatus.Deleted && s.Status != StudyStatus.Archived)
            .Include(s => s.Patient)
            .Select(s => new
            {
                s.Id,
                PatientName = s.Patient != null ? s.Patient.PatientName : "",
                s.StudyDate,
                Modality = s.Series.Select(x => x.Modality).FirstOrDefault() ?? "",
                ImageCount = s.Series.Select(x => x.Images.Count).Sum()
            })
            .OrderByDescending(s => s.StudyDate)
            .ToListAsync();

        MergeCandidates = candidates.Select(c => new MergeCandidateRow(
            c.Id,
            DicomHelpers.FormatPatientName(c.PatientName),
            c.StudyDate?.ToString("dd/MM/yyyy") ?? "Date inconnue",
            string.IsNullOrWhiteSpace(c.Modality) ? "—" : c.Modality,
            c.ImageCount)).ToList();
        await InvokeAsync(StateHasChanged);
    }

    private void CancelMergePicker() { ShowMergePicker = false; MergeSource = null; }

    private void SelectMergeTarget(MergeCandidateRow c)
    {
        MergeTarget = c;
        ShowMergePicker = false;
    }

    private void CancelMerge() { MergeTarget = null; MergeSource = null; }

    private async Task ConfirmMerge()
    {
        if (IsMerging || MergeTarget == null || MergeSource == null) return;
        var sourceId = MergeSource.Id;
        var sourceName = DicomHelpers.FormatPatientName(MergeSource.Patient?.PatientName);
        var targetId = MergeTarget.StudyId;
        MergeTarget = null;
        MergeSource = null;
        IsMerging = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var ok = await StudyService.MergeStudyAsync(sourceId, targetId);
            if (ok)
            {
                await ShowToast($"« {sourceName} » fusionnée avec succès.");
                await LoadDataAsync();
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                await ShowToast("Impossible de fusionner les études.", true);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Merge failed for Study {SourceId} -> {TargetId}", sourceId, targetId);
            await ShowToast("Erreur lors de la fusion.", true);
        }
        finally
        {
            IsMerging = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private int _toastSeq;

    private async Task ShowToast(string message, bool isError = false)
    {
        var seq = ++_toastSeq;
        StatusMessage = message;
        IsError = isError;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(3000);
        if (seq != _toastSeq) return;
        StatusMessage = "";
        IsError = false;
        await InvokeAsync(StateHasChanged);
    }

    private void ClearToast()
    {
        StatusMessage = "";
        StateHasChanged();
    }

    public void Dispose()
    {
        NotificationService.OnStudyChanged -= HandleStudyChanged;
    }
}



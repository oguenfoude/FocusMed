<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
                <FocusOnNavigate RouteData="routeData" Selector="h1" />
            </ChildContent>
            <ErrorContent Context="ex">
                @* Inline styles on purpose: this fallback must render even if app.css fails to load. *@
                <div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:#f1f5f9;padding:24px;font-family:system-ui,sans-serif;">
                    <div style="background:#fff;border-radius:12px;padding:32px;max-width:480px;text-align:center;box-shadow:0 4px 24px rgba(0,0,0,.08);">
                        <h1 style="font-size:20px;color:#0f172a;margin:0 0 8px;">Une erreur est survenue</h1>
                        <p style="font-size:14px;color:#64748b;margin:0 0 8px;">La page n'a pas pu s'afficher. Vos données sont intactes.</p>
                        <p style="font-size:12px;color:#94a3b8;margin:0 0 20px;word-break:break-word;">@ex.Message</p>
                        <button onclick="location.reload()" style="background:#2563eb;color:#fff;border:none;border-radius:8px;padding:10px 24px;font-size:14px;cursor:pointer;">Recharger la page</button>
                    </div>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </Found>
</Router>

@code {
    private ErrorBoundary? _errorBoundary;

    protected override void OnParametersSet() => _errorBoundary?.Recover();
}
